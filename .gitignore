# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
coverage.txt
coverage.html
profile.cov

# Dependency directories (remove the comment below to include it)
# Note: Modern Go projects use go.mod/go.sum, so vendor is usually ignored
vendor/

# Go workspace file (for Go 1.18+ workspaces)
go.work
go.work.sum

# Environment variables and secrets
.env
.env.local

# IDE and Editor files
.idea/
.vscode/
*.swp
*.swo
*~

# Build output directories (common convention)
/bin/
/dist/
/build/

# OS specific files
.DS_Store
Thumbs.db   